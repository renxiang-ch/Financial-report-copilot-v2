# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored -- real keys never enter version control.
#     cp .env.example .env

# ── LLM (required for the agent and the eval harness) ────────────────────────
# Any OpenAI-compatible endpoint works: leave OPENAI_BASE_URL empty for
# api.openai.com, or point it at an aggregator's endpoint.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL 17+ with the pgvector extension installed.
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/financial_copilot

# ── API auth (optional) ──────────────────────────────────────────────────────
# If set, /ask requires this value in the X-API-Key header.
# Empty = open access, which is fine for local use.
API_KEY=

# ── Frontend (optional; read from env or Streamlit secrets) ──────────────────
API_URL=http://localhost:8000
# If set, the Streamlit UI shows a password gate before anything else.
APP_PASSWORD=
# Models offered in the chat model picker, comma-separated.
AVAILABLE_MODELS=gpt-4o-mini,gpt-4o

# ── v2 graph runtime (optional; defaults keep eval runs reproducible) ────────
# Checkpointer for copilot.v2.orchestration.graph. `memory` (default) keeps
# threads in-process; `postgres` persists them to DATABASE_URL so a conversation
# survives a restart. Tables (checkpoints, checkpoint_blobs, checkpoint_writes,
# checkpoint_migrations) are created on first use.
COPILOT_CHECKPOINTER=memory
# Comma-separated models to try when the primary model call *errors*
# (429 / 5xx / timeout / context overflow) -- never on answer quality.
# Empty (default) = no fallback. Example: gpt-4o
COPILOT_FALLBACK_MODELS=

# ── Langfuse observability (optional; leave empty to disable) ────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── LangSmith tracing (optional; per-node timing / tokens / retries) ─────────
# `create_agent` traces with no code changes, BUT the langsmith SDK reads
# os.environ while these values live here in .env -- which pydantic-settings
# loads without exporting. copilot.v2.observability.enable_tracing() bridges the
# gap (and clears the SDK's lru_cache); without it, filling these in enables
# nothing and fails silently. Off by default so eval sweeps stay reproducible.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Project traces land in. Eval sweeps override it per run (frc-eval-<impl>) so
# hundreds of scored runs don't bury the ones you're debugging.
LANGSMITH_PROJECT=frc-dev
# REQUIRED for non-US accounts -- without it the key is not recognised and auth
# fails. EU: https://eu.api.smith.langchain.com · APAC: https://apac.api.smith.langchain.com
# AWS US: https://aws.api.smith.langchain.com · GCP US (default): leave empty.
# No trailing slash.
LANGSMITH_ENDPOINT=

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
